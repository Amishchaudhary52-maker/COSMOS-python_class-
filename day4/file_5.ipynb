    "import math,random\n",
    "roll1=random.randint(1,6)\n",
    "roll2=random.randint(1,6)\n",
    "print(f\"Roll_1: {roll1} | ROll_2: {roll2}\")\n",
    "total_sum=roll1+roll2\n",
    "print(f\"sum:{total_sum}\")\n",
    "root_val=math.sqrt(total_sum)\n",
    "print(f\"Square root: {root_val:.4f}\")\n"
   ]
